generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Song {
  id         String   @id @default(cuid())
  title      String
  artist     String
  category   String
  coverImage String
  audioUrl   String
  duration   Int?
  createdAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([title])
  @@index([artist])
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model SiteSettings {
  id            String   @id @default(cuid())
  siteName      String   @default("Music Flow")
  instagramUrl  String?
  updatedAt     DateTime @updatedAt
}